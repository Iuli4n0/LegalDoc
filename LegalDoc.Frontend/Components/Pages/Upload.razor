@page "/upload"
@rendermode InteractiveServer
@using LegalDoc.Frontend.Models
@using LegalDoc.Frontend.Services
@inject ApiClient ApiClient
@inject ISnackbar Snackbar
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>LegalDoc - Upload Document</PageTitle>

@if (!_authReady)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mr-2"/>
        <MudText Typo="Typo.body1">Initializing session...</MudText>
    </MudPaper>
}

<MudText Typo="Typo.h4" GutterBottom="true">Upload Document</MudText>

@if (_limits is not null)
{
    var percentUsed = _limits.MaxDocuments > 0 
        ? (double)_limits.MonthlyDocumentsUploaded / _limits.MaxDocuments * 100 
        : 100;
    Color quotaColor;

    if (percentUsed >= 100)
    {
        quotaColor = Color.Error;
    }
    else if (percentUsed >= 80)
    {
        quotaColor = Color.Warning;
    }
    else
    {
        quotaColor = Color.Success;
    }

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    Upload Quota
                    <MudChip T="string" Size="Size.Small" Color="@GetPlanChipColor(_limits.SubscriptionPlan)" 
                             Style="margin-left:12px; vertical-align:middle;">
                        @_limits.SubscriptionPlan
                    </MudChip>
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body1">
                        Documents this month: <strong>@_limits.MonthlyDocumentsUploaded / @_limits.MaxDocuments</strong>
                    </MudText>
                    <MudProgressLinear Color="@quotaColor" 
                                       Value="@percentUsed" 
                                       Class="my-2" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @_limits.RemainingUploads uploads remaining
                    </MudText>
                    @if (!_limits.CanUpload)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2 text-sm">
                            You've reached your monthly document limit.
                            <MudLink Href="/pricing" Class="ml-1">Upgrade plan</MudLink>
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body1" Class="mb-2">
                        Max file size: <strong>@_limits.MaxDocumentSizeMb MB</strong>
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">
                        Total uploaded (all time): <strong>@_limits.TotalDocumentsUploaded</strong>
                    </MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="text-sm">
                        Limit resets on: @_limits.CurrentPeriodEnd.ToLocalTime().ToString("dd.MM.yyyy")
                    </MudAlert>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

<MudCard Class="mb-4">
    <MudCardContent>
        <div>
            <label class="mud-file-label" style="display:inline-block">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           Disabled="@(_limits is not null && !_limits.CanUpload)">
                    Select File
                </MudButton>
                <InputFile OnChange="OnInputFileChanged" accept=".pdf,.doc,.docx,.txt" style="display:none" />
            </label>
        </div>

        @if (_selectedFile is not null)
        {
            var isTooLarge = _limits is not null && (_selectedFile.Size > _limits.MaxDocumentSizeMb * 1024 * 1024);
            <MudAlert Severity="@(isTooLarge ? Severity.Error : Severity.Info)" Class="mt-3">
                <strong>Selected file:</strong> @_selectedFile.Name (@FormatFileSize(_selectedFile.Size))
                @if (isTooLarge)
                {
                    <br/><span class="mt-1 d-block">File exceeds the maximum allowed size of @_limits!.MaxDocumentSizeMb MB.</span>
                }
            </MudAlert>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!_authReady || _selectedFile is null || _uploading || (_limits is not null && (!_limits.CanUpload || _selectedFile.Size > _limits.MaxDocumentSizeMb * 1024 * 1024)))"
                   OnClick="UploadFile"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
            @if (_uploading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Uploading...</MudText>
            }
            else
            {
                <MudText>Upload Document</MudText>
            }
        </MudButton>
    </MudCardActions>
</MudCard>

@if (_uploadResult is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Document uploaded successfully!
    </MudAlert>

    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Document Details</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    <tr><td><strong>ID</strong></td><td>@_uploadResult.Id</td></tr>
                    <tr><td><strong>File Name</strong></td><td>@_uploadResult.FileName</td></tr>
                    <tr><td><strong>Content Type</strong></td><td>@_uploadResult.ContentType</td></tr>
                    <tr><td><strong>Size</strong></td><td>@FormatFileSize(_uploadResult.FileSize)</td></tr>
                    <tr><td><strong>Upload Date</strong></td><td>@_uploadResult.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       Href="@($"/documents/{_uploadResult.Id}")">
                View Document Details
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private bool _authReady;
    private UploadDocumentResponse? _uploadResult;
    private UserLimitsResponse? _limits;
    private readonly TaskCompletionSource _authInitialized = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        _authReady = true;
        _authInitialized.TrySetResult();
        StateHasChanged();
        
        await LoadLimits();
    }

    private async Task LoadLimits()
    {
        try
        {
            await _authInitialized.Task;
            var identityClient = ApiClient.CreateIdentityClient();
            var jwt = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler().ReadJwtToken(AuthState.Token);
            var userId = jwt.Claims.First(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier || c.Type == "sub").Value;
            
            _limits = await identityClient.GetFromJsonAsync<UserLimitsResponse>($"/api/auth/users/{userId}/limits");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not load limits: {ex.Message}");
        }
    }

    private void OnFileSelected(IBrowserFile? file)
    {
        _selectedFile = file;
        _uploadResult = null;
    }

    private void OnInputFileChanged(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(1);
        var file = files.FirstOrDefault();
        OnFileSelected(file);
        StateHasChanged();
    }

    private async Task UploadFile()
    {
        if (!_authReady || !AuthState.IsAuthenticated)
            return;

        if (_selectedFile is null) return;
        
        if (_limits is not null && !_limits.CanUpload)
        {
            Snackbar.Add("You've reached your monthly document limit.", Severity.Error);
            return;
        }

        if (_limits is not null && _selectedFile.Size > _limits.MaxDocumentSizeMb * 1024 * 1024)
        {
            Snackbar.Add($"File exceeds the maximum size of {_limits.MaxDocumentSizeMb} MB.", Severity.Error);
            return;
        }

        _uploading = true;

        try
        {
            var client = ApiClient.CreateClient();

            using var content = new MultipartFormDataContent();
            var stream = _selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_selectedFile.ContentType);
            content.Add(streamContent, "file", _selectedFile.Name);

            var response = await client.PostAsync("/api/documents/upload", content);

            if (response.IsSuccessStatusCode)
            {
                _uploadResult = await response.Content.ReadFromJsonAsync<UploadDocumentResponse>();
                Snackbar.Add("Document uploaded successfully!", Severity.Success);
                await LoadLimits(); // Refresh limits after successful upload
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Eroare upload: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        var order = 0;
        double size = bytes;
        while (size >= 1024 && order < sizes.Length - 1)
        {
            order++;
            size /= 1024;
        }
        return $"{size:0.##} {sizes[order]}";
    }

    private static Color GetPlanChipColor(string plan) => plan switch
    {
        "Bronze" => Color.Warning,
        "Silver" => Color.Default,
        "Gold" => Color.Warning,
        _ => Color.Default
    };
}
