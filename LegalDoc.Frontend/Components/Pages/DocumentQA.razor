@page "/documents/{Id:guid}/qa"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using LegalDoc.Frontend.Models
@using LegalDoc.Frontend.Services
@inject ApiClient ApiClient
@inject ISnackbar Snackbar
@inject AuthService AuthService
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Document Q&A</PageTitle>

<style>
    .qa-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 140px);
        max-width: 900px;
        margin: 0 auto;
    }
    .qa-header {
        flex-shrink: 0;
    }
    .chat-area {
        flex: 1;
        overflow-y: auto;
        padding: 16px 0;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .chat-bubble {
        max-width: 85%;
        padding: 14px 18px;
        border-radius: 16px;
        line-height: 1.6;
        word-wrap: break-word;
        font-size: 0.95rem;
    }
    .chat-bubble-user {
        align-self: flex-end;
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
        color: white;
        border-bottom-right-radius: 4px;
    }
    .chat-bubble-assistant {
        align-self: flex-start;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-bottom-left-radius: 4px;
        color: var(--mud-palette-text-primary);
    }
    .chat-bubble-assistant pre {
        white-space: pre-wrap;
        margin: 0;
        font-family: inherit;
    }
    .source-chip {
        cursor: pointer;
        margin-top: 8px;
    }
    .source-panel {
        background: var(--mud-palette-background-gray);
        border-radius: 8px;
        padding: 12px;
        margin-top: 8px;
        font-size: 0.85rem;
        border-left: 3px solid #7c3aed;
    }
    .input-area {
        flex-shrink: 0;
        padding: 12px 0;
        border-top: 1px solid var(--mud-palette-lines-default);
    }
    .typing-indicator {
        display: flex;
        gap: 4px;
        align-items: center;
        padding: 14px 18px;
    }
    .typing-dot {
        width: 8px;
        height: 8px;
        background: var(--mud-palette-primary);
        border-radius: 50%;
        animation: typing 1.4s infinite both;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typing {
        0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
    }
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        text-align: center;
        gap: 16px;
        opacity: 0.7;
    }
    .empty-state-icon {
        font-size: 64px !important;
        color: var(--mud-palette-primary);
    }
</style>

<div class="qa-container">
    @* ── Header ── *@
    <div class="qa-header">
        <MudPaper Class="pa-3 mb-2" Elevation="0">
            <div style="display: flex; align-items: center; gap: 12px;">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Navigation.NavigateTo($"/documents/{Id}"))"
                               Size="Size.Small" />
                @if (_document is not null)
                {
                    <MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                            Q&A: @_document.FileName
                        </MudText>
                    </div>
                    <MudSpacer />
                }
                else if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText>Loading document...</MudText>
                }
            </div>
        </MudPaper>
    </div>

    @* ── Chat Area ── *@
    <div class="chat-area" id="chat-area">
        @if (_messages.Count == 0 && !_loading)
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Forum" Class="empty-state-icon" />
                <MudText Typo="Typo.h6">Ask anything about your document</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    The AI will search through the document and provide answers based on the content.
                </MudText>
                <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 8px;">
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small"
                             OnClick="@(() => AskSuggested("Care sunt părțile implicate în contract?"))">
                        Care sunt părțile implicate?
                    </MudChip>
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small"
                             OnClick="@(() => AskSuggested("Care este obiectul contractului?"))">
                        Care este obiectul contractului?
                    </MudChip>
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small"
                             OnClick="@(() => AskSuggested("Care este durata contractului?"))">
                        Care este durata contractului?
                    </MudChip>
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small"
                             OnClick="@(() => AskSuggested("Există penalități sau clauze de reziliere?"))">
                        Penalități / Reziliere?
                    </MudChip>
                </div>
            </div>
        }

        @foreach (var msg in _messages)
        {
            @if (msg.IsUser)
            {
                <div class="chat-bubble chat-bubble-user">
                    @msg.Text
                </div>
            }
            else
            {
                <div class="chat-bubble chat-bubble-assistant">
                    <pre>@msg.Text</pre>
                    @if (msg.Sources is { Count: > 0 })
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@(msg.ShowSources ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => ToggleSources(msg))"
                                   Class="source-chip">
                            @(msg.ShowSources ? "Hide sources" : $"Show {msg.Sources.Count} sources")
                        </MudButton>

                        @if (msg.ShowSources)
                        {
                            @foreach (var source in msg.Sources)
                            {
                                <div class="source-panel">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-bottom: 4px;">
                                        📄 Chunk #@(source.ChunkIndex + 1) — Distance: @source.Distance.ToString("0.####")
                                    </MudText>
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@source.Text</MudText>
                                </div>
                            }
                        }
                    }
                </div>
            }
        }

        @if (_answering)
        {
            <div class="chat-bubble chat-bubble-assistant typing-indicator">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        }
    </div>

    @* ── Input Area ── *@
    <div class="input-area">
        <MudPaper Class="pa-2" Elevation="1" Style="border-radius: 12px;">
            <div style="display: flex; gap: 8px; align-items: center;">
                <MudTextField @bind-Value="_question"
                              Placeholder="Ask a question about the document..."
                              Variant="Variant.Text"
                              Margin="Margin.Dense"
                              Style="flex: 1;"
                              Immediate="true"
                              OnKeyUp="HandleKeyUp"
                              Disabled="@(_answering || !_authReady || _document is null)" />
                <MudIconButton Icon="@Icons.Material.Filled.Send"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               OnClick="AskQuestion"
                               Disabled="@(_answering || string.IsNullOrWhiteSpace(_question) || !_authReady || _document is null)" />
            </div>
        </MudPaper>
    </div>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private string _question = string.Empty;
    private bool _loading;
    private bool _authReady;
    private bool _answering;
    private GetDocumentResponse? _document;
    private Guid? _pendingDocumentId;
    private readonly List<ChatMessage> _messages = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitializeAsync();

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: false);
            return;
        }

        _authReady = true;

        if (_pendingDocumentId.HasValue)
        {
            await LoadDocument(_pendingDocumentId.Value);
            _pendingDocumentId = null;
        }

        StateHasChanged();
    }

    protected override Task OnParametersSetAsync()
    {
        if (!Id.HasValue)
            return Task.CompletedTask;

        if (_authReady)
            return LoadDocument(Id.Value);

        _pendingDocumentId = Id.Value;
        return Task.CompletedTask;
    }

    private async Task LoadDocument(Guid id)
    {
        if (!_authReady || !AuthState.IsAuthenticated)
        {
            _pendingDocumentId = id;
            return;
        }

        _loading = true;

        try
        {
            var client = ApiClient.CreateClient();

            // Load document info
            var response = await client.GetAsync($"/api/documents/{id}");
            if (response.IsSuccessStatusCode)
            {
                _document = await response.Content.ReadFromJsonAsync<GetDocumentResponse>();

                // Load Q&A history
                var historyResponse = await client.GetAsync($"/api/documents/{id}/qa-history");
                if (historyResponse.IsSuccessStatusCode)
                {
                    var history = await historyResponse.Content.ReadFromJsonAsync<GetDocumentConversationResponse>();
                    if (history?.Messages is not null)
                    {
                        _messages.Clear();
                        foreach (var msg in history.Messages)
                        {
                            List<SourceChunkItem>? sources = null;
                            if (!string.IsNullOrEmpty(msg.SourcesJson))
                            {
                                try
                                {
                                    sources = System.Text.Json.JsonSerializer.Deserialize<List<SourceChunkItem>>(
                                        msg.SourcesJson, 
                                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                                }
                                catch { }
                            }
                            
                            _messages.Add(new ChatMessage
                            {
                                IsUser = msg.IsUser,
                                Text = msg.Text,
                                Sources = sources
                            });
                        }
                    }
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Document not found.", Severity.Warning);
                Navigation.NavigateTo("/profile");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading document: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_question) && !_answering)
        {
            await AskQuestion();
        }
    }

    private async Task AskSuggested(string question)
    {
        _question = question;
        await AskQuestion();
    }

    private async Task AskQuestion()
    {
        if (string.IsNullOrWhiteSpace(_question) || _document is null || _answering)
            return;

        var question = _question.Trim();
        _question = string.Empty;

        // Add user message
        _messages.Add(new ChatMessage { IsUser = true, Text = question });
        _answering = true;
        StateHasChanged();

        try
        {
            var client = ApiClient.CreateClient();
            var request = new AskQuestionRequest(question);

            var response = await client.PostAsJsonAsync($"/api/documents/{_document.Id}/ask", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AskQuestionResponse>();

                if (result is not null)
                {
                    var assistantMsg = new ChatMessage
                    {
                        IsUser = false,
                        Text = result.Answer,
                        Sources = result.SourceChunks
                    };
                    _messages.Add(assistantMsg);

                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _messages.Add(new ChatMessage
                {
                    IsUser = false,
                    Text = $"⚠️ Error: {error}"
                });
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                IsUser = false,
                Text = $"⚠️ Connection error: {ex.Message}"
            });
        }
        finally
        {
            _answering = false;
        }
    }


    private void ToggleSources(ChatMessage msg)
    {
        msg.ShowSources = !msg.ShowSources;
    }

    private class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Text { get; set; } = string.Empty;
        public List<SourceChunkItem>? Sources { get; set; }
        public bool ShowSources { get; set; }
    }
}
